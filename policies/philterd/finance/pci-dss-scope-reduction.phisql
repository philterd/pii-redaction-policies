-- PhiSQL equivalent of pci-dss-scope-reduction.json, side by side for comparison.
--
-- PhiSQL v0.1 covers the redaction subset and compiles to the same Phileas
-- JSON schema. Notes on what is not yet expressible in v0.1:
--   * LAST_4 keeps the last four characters, matching the JSON policy's
--     MASK with leaveCharacters: 4 on the card and IBAN.
--   * The creditCard "onlyValidCreditCards" flag has no v0.1 keyword.
--   * The custom regex identifiers (cvv, card-expiration) cannot be defined
--     inline in v0.1; keep those in the JSON policy for now.

POLICY pci_dss_scope_reduction;

REDACT CREDIT_CARD, IBAN_CODE WITH LAST_4;

REDACT SSN WITH REDACT(format='[REDACTED-SSN]');
