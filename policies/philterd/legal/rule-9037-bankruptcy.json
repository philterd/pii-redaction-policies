{
  "name": "rule-9037-bankruptcy",
  "config": {
    "splitting": {
      "enabled": false,
      "threshold": 4000
    }
  },
  "ignored": [],
  "identifiers": {
    "ssn": {
      "ssnFilterStrategies": [
        {"strategy": "MASK", "maskCharacter": "x", "maskLength": "SAME", "leaveCharacters": 4}
      ]
