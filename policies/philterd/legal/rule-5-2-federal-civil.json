{
  "config": {
    "splitting": {
      "enabled": false,
      "threshold": 4000
    }
  },
  "ignored": [],
  "identifiers": {
    "ssn": {
      "ssnFilterStrategies": [
        {
          "strategy": "MASK",
          "maskCharacter": "x",
          "maskLength": "SAME",
          "leaveCharacters": 4
        }
      ]
    },
    "date": {
      "onlyValidDates": true,
      "dateFilterStrategies": [
        {
          "strategy": "TRUNCATE",
          "redactionFormat": "%Y",
          "condition": "context == \"birth\""
        }
      ]
    },
    "firstName": {
      "firstNameFilterStrategies": [
        {
          "strategy": "ABBREVIATE",
          "abbreviateFormat": "INITIALS",
          "condition": "context == \"minor\""
        }
      ]
    },
    "surname": {
      "surnameFilterStrategies": [
        {
          "strategy": "ABBREVIATE",
          "abbreviateFormat": "INITIALS",
          "condition": "context == \"minor\""
        }
      ]
    },
    "pheyes": [
      {
        "phEyeFilterStrategies": [
          {
            "strategy": "ABBREVIATE",
            "abbreviateFormat": "INITIALS",
            "condition": "context == \"minor\""
          }
        ],
        "phEyeConfiguration": {
          "labels": [
            "PERSON"
          ]
        }
      }
    ],
    "identifiers": [
      {
        "classification": "tin",
        "pattern": "\\b\\d{2}[-\\s]?\\d{7}\\b",
        "identifierFilterStrategies": [
          {
            "strategy": "MASK",
            "maskCharacter": "x",
            "maskLength": "SAME",
            "leaveCharacters": 4
          }
        ]
      },
      {
        "classification": "financial-account",
        "pattern": "\\b(?:ACCT|ACCOUNT)[\\s:#]*\\d{6,}\\b",
        "caseSensitive": false,
        "identifierFilterStrategies": [
          {
            "strategy": "MASK",
            "maskCharacter": "x",
            "maskLength": "SAME",
            "leaveCharacters": 4
          }
        ]
      }
    ]
  }
}
