-- PhiSQL equivalent of hipaa-safe-harbor.json, side by side for comparison.
--
-- PhiSQL v0.1 covers the redaction subset and compiles to the same Phileas
-- JSON schema. Notes on what is not yet expressible in v0.1:
--   * v0.1 has no PERSON entity, so personsName is expressed as the
--     FIRST_NAME + SURNAME pair (the v0.1 substitution for PERSON).
--   * ZIP_CODE is truncated; the JSON policy's truncateDigits: 3 (Safe Harbor
--     three-digit ZIP) has no v0.1 argument, so the digit count stays in JSON.
--   * The age "context == age > 89" condition and the custom regex
--     identifiers (mrn, account-number) cannot be expressed in v0.1; keep
--     those in the JSON policy for now.

POLICY hipaa_safe_harbor
  DESCRIPTION 'HIPAA Safe Harbor de-identification (45 CFR 164.514(b)(2)).';

REDACT
  AGE, DATE, PHONE_NUMBER, EMAIL_ADDRESS, SSN, IP_ADDRESS, URL,
  FIRST_NAME, SURNAME, HOSPITAL, CITY, COUNTY
  WITH REDACT;

REDACT ZIP_CODE WITH TRUNCATE;
