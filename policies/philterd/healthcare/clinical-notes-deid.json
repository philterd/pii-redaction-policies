        {
          "strategy": "REDACT",
          "redactionFormat": "[PATIENT]",
          "condition": "confidence > 60"
        }
      ]
    },
    "physicianName": {
      "physicianNameFilterStrategies": [
        {
          "strategy": "REDACT",
          "redactionFormat": "[PROVIDER]"
        }
      ]
